    {
      "cell_type": "markdown",
      "source": [
        "# Verify the Test Error"
      ],
      "metadata": {
        "id": "k7i-5SsPaQxe"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "y_pred = best_lasso.predict(X_test)\n",
        "print(root_mean_squared_error(y_test, y_pred))"
      ],
      "metadata": {
        "id": "QSWUOzEidFEH",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "e673967b-6cfe-4e16-b9c4-415785ed97b5"
      },
