          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Hyperparameter Tune Your Lasso Model"
      ],
      "metadata": {
        "id": "dKTz8PbbZ6Jl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "np.linspace(0.001, 1, 10)"
      ],
      "metadata": {
        "id": "9DbvjZbYdDiz",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "c9a11bc3-896e-460f-e0d5-4781654c3803"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "array([0.001, 0.112, 0.223, 0.334, 0.445, 0.556, 0.667, 0.778, 0.889,\n",
              "       1.   ])"
            ]
          },
          "metadata": {},
          "execution_count": 12
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "np.logspace(-3, 2, 11)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "IV88zsxvhGvW",
        "outputId": "7731ba49-d646-4796-81df-3438f7ad65ce"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "array([1.00000000e-03, 3.16227766e-03, 1.00000000e-02, 3.16227766e-02,\n",
              "       1.00000000e-01, 3.16227766e-01, 1.00000000e+00, 3.16227766e+00,\n",
              "       1.00000000e+01, 3.16227766e+01, 1.00000000e+02])"
            ]
          },
          "metadata": {},
          "execution_count": 13
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "alphas = np.logspace(-3, 4.2, 1000)\n",
        "\n",
        "train_errors = []\n",
        "test_errors = []\n",
        "\n",
        "for alpha in alphas:\n",
        "    lasso = Lasso(alpha=alpha)\n",
        "    lasso.fit(X_train, y_train)\n",
        "\n",
        "    train_errors.append(root_mean_squared_error(y_train, lasso.predict(X_train)))\n",
        "    test_errors.append(root_mean_squared_error(y_test, lasso.predict(X_test)))"
      ],
      "metadata": {
        "id": "7nTXF6s5htrM"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.plot(alphas, train_errors, label='Train')\n",
        "plt.plot(alphas, test_errors, label='Test')\n",
        "plt.xlabel('Alpha')\n",
        "plt.ylabel('Root Mean Squared Error')\n",
        "plt.title('Root Mean Squared Error vs Alpha')\n",
        "plt.legend()\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 472
        },
        "id": "hBWTDKemjD5D",
        "outputId": "9ffaa885-4945-4f4e-cb5c-0d10cd8bc788"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Specify the Best Alpha"
      ],
      "metadata": {
        "id": "nb7aO41maEmK"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "idx = np.argmin(test_errors)\n",
        "best_alpha = alphas[idx]\n",
        "print(best_alpha)"
      ],
      "metadata": {
        "id": "UXBSuj4idEL8",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "e858c429-c3c9-46db-df95-4c5f79a82627"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "8296.958520834914\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "best_lasso = Lasso(alpha=best_alpha)\n",
        "best_lasso.fit(X_train, y_train)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 80
        },
        "id": "pK4pAEvMl12d",
