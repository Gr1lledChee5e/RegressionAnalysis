    {
      "cell_type": "code",
      "source": [
        "from sklearn.linear_model import ElasticNetCV\n",
        "alphas = np.logspace(-3, 2, 1000)\n",
        "l1_ratios = np.linspace(0.01, 1, 10)\n",
        "elastic_net = ElasticNetCV(l1_ratio=l1_ratios, alphas = alphas, cv=5, random_state=55)\n",
        "elastic_net.fit(X_train, y_train)"
