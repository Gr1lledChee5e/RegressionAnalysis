        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Split and Fit a Lasso Model"
      ],
      "metadata": {
        "id": "fwW2NBlxZz_F"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "y = df['Revenue']\n",
        "X = df.iloc[:, 5:]"
      ],
      "metadata": {
        "id": "HtULu33udDDo"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "X.columns"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "3awCNlWgeaoF",
        "outputId": "f6da2799-801b-44aa-e62d-bedfc7184af0"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "Index(['PC1', 'PC2', 'PC3', 'PC4', 'PC5', 'PC6', 'PC7', 'PC8', 'PC9', 'PC10',\n",
              "       'PC11', 'PC12', 'PC13', 'PC14', 'PC15', 'PC16', 'PC17', 'PC18', 'PC19',\n",
              "       'PC20', 'PC21', 'PC22', 'PC23', 'PC24', 'PC25', 'PC26', 'PC27', 'PC28',\n",
              "       'PC29', 'PC30', 'PC31', 'PC32', 'PC33', 'PC34', 'PC35', 'PC36', 'PC37',\n",
              "       'PC38', 'PC39', 'PC40'],\n",
              "      dtype='object')"
            ]
          },
          "metadata": {},
          "execution_count": 8
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=41)"
      ],
      "metadata": {
        "id": "soGnpT4ve9ps"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Alpha is the amount of penalty"
      ],
      "metadata": {
        "id": "sfD123fOfj6b"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import root_mean_squared_error\n",
        "\n",
        "lasso = Lasso(alpha=0.1)\n",
        "lasso.fit(X_train, y_train)\n",
        "\n",
        "y_pred = lasso.predict(X_test)\n",
        "\n",
        "print(mean_squared_error(y_test, y_pred))\n",
        "print(root_mean_squared_error(y_test, y_pred))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "MBCwN68_fTF3",
        "outputId": "505a20a5-ec55-4000-a576-18e853405a66"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "3757321581.6707478\n",
            "61296.99488287128\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "print(lasso.coef_)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "w-cEZD2vgvkA",
        "outputId": "e4ffc482-d01f-4251-f227-97b21de91ba5"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "[ 3708.14289583  1359.7400096   1954.39175036 -1622.52593255\n",
            "  2819.52476804   203.77634577  6716.62004703 -3978.04886454\n",
            " -1230.52579014 -5823.19664221   322.57055229  -279.99267883\n",
