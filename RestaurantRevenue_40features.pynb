        "# Print Model Coefficients"
      ],
      "metadata": {
        "id": "ijcy0eM6aV2l"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "best_lasso.coef_"
      ],
      "metadata": {
        "id": "j2wD39nJdFln",
