    {
      "cell_type": "markdown",
      "source": [
        "# Create a Variable Importance Plot"
      ],
      "metadata": {
        "id": "vKOI85AKabI-"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "abs_coef = np.abs(best_lasso.coef_)\n",
        "\n",
        "feature_names = X_train.columns\n",
        "sorted_idx = np.argsort(abs_coef)[::-1]\n",
        "top_10_idx = sorted_idx[:10]\n",
        "sorted_abs_coef = abs_coef[top_10_idx]\n",
        "sorted_feature_names = feature_names[top_10_idx]\n",
        "plt.barh(sorted_feature_names, sorted_abs_coef)\n",
        "plt.gca().invert_yaxis()\n",
        "plt.xlabel('Absolute Coefficient Value')\n",
        "plt.ylabel('Feature')\n",
        "plt.title('Variable Importance')\n",
        "plt.xticks()\n",
        "plt.show()"
      ],
      "metadata": {
        "id": "2la5LYhEdGRT",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 472
        },
        "outputId": "78c3add2-9e0f-484e-c288-163eddc4c3cf"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# Find the Best Alpha for Ridge"
      ],
      "metadata": {
        "id": "4a_wezeAsUNH"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.linear_model import Ridge\n",
        "alphas = np.logspace(-3, 4, 1000)\n",
        "\n",
        "train_errors = []\n",
        "test_errors = []\n",
        "\n",
        "for alpha in alphas:\n",
        "    ridge = Ridge(alpha=alpha)\n",
        "    ridge.fit(X_train, y_train)\n",
        "    train_errors.append(root_mean_squared_error(y_train, ridge.predict(X_train)))\n",
        "    test_errors.append(root_mean_squared_error(y_test, ridge.predict(X_test)))"
      ],
      "metadata": {
        "id": "iyJnLxjpsTku"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "plt.plot(alphas, train_errors, label='Train')\n",
        "plt.plot(alphas, test_errors, label='Test')\n",
        "plt.xlabel('Alpha')\n",
        "plt.ylabel('Root Mean Squared Error')\n",
        "plt.title('Root Mean Squared Error vs Alpha')"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 490
        },
        "id": "UFQ_A0xKtE7Y",
        "outputId": "1b848092-a901-496c-f23c-68eed06ab3fb"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "Text(0.5, 1.0, 'Root Mean Squared Error vs Alpha')"
            ]
          },
          "metadata": {},
          "execution_count": 22
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "idx = np.argmin(test_errors)\n",
        "best_alpha = alphas[idx]\n",
        "print(best_alpha)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "IdxkgU0ksZnv",
        "outputId": "f9f45c7a-4d00-4d06-bcc2-ff1811c321c3"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1615.1326935030897\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "best_ridge = Ridge(alpha=best_alpha)\n",
        "best_ridge.fit(X_train, y_train)"
      ],
      "metadata": {
        "colab": {
