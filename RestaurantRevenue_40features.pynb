      "source": [
        "alphas = np.logspace(-3, 4, 1000)\n",
        "l1_ratios = np.linspace(0.01, 1, 10)\n",
        "\n",
        "train_errors = []\n",
        "test_errors = []\n",
        "\n",
        "for alpha in alphas:\n",
        "    for l1_ratio in l1_ratios:\n",
        "        elastic_net = ElasticNet(alpha=alpha, l1_ratio=l1_ratio)\n",
        "        elastic_net.fit(X_train, y_train)\n",
        "        train_errors.append(root_mean_squared_error(y_train, elastic_net.predict(X_train)))\n",
        "        test_errors.append(root_mean_squared_error(y_test, elastic_net.predict(X_test)))"
